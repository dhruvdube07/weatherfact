package com.weatherfact.core;

import java.util.*;
import java.time.LocalDateTime;

/**
 * WEATHERFACT GLOBAL ORCHESTRATOR v4.0
 * Handles Sector Intelligence, Thermal Protocols, and Geolocation Logic.
 */
public class IntelligenceTerminal {

    private static final double TARGET_LAT = 19.3512;
    private static final double TARGET_LON = 72.8015;

    public static void main(String[] args) {
        System.out.println("--- INITIALIZING SECTOR INTELLIGENCE TERMINAL ---");
        
        // Simulate an environment scan
        Sector currentSector = new Sector("Nala Sopara", 19.4167, 72.8167);
        ThermalProfile profile = new ThermalProfile(27.5, 65.0);
        
        IntelligenceTerminal terminal = new IntelligenceTerminal();
        terminal.processSectorData(currentSector, profile);
    }

    public void processSectorData(Sector sector, ThermalProfile thermal) {
        double distance = calculateHaversine(sector.lat, sector.lon, TARGET_LAT, TARGET_LON);
        double coolingLoad = calculateCoolingOptimization(thermal.temp, thermal.humidity);
        
        System.out.println("SYNC STATUS: [ACTIVE]");
        System.out.println("LOCATION: " + sector.name.toUpperCase());
        System.out.printf("PROXIMITY TO WETLANDS: %.2f KM\n", distance);
        System.out.printf("NASA LIDAR ANALYSIS: ALBEDO SUB-OPTIMAL. POTENTIAL COOLING: %.2f KW\n", coolingLoad);
        
        generateExpeditionReport();
    }

    /**
     * Implementation of the Haversine formula to determine distance between two points.
     */
    private double calculateHaversine(double lat1, double lon1, double lat2, double lon2) {
        final int R = 6371; // Earth radius in KM
        double latDistance = Math.toRadians(lat2 - lat1);
        double lonDistance = Math.toRadians(lon2 - lon1);
        double a = Math.sin(latDistance / 2) * Math.sin(latDistance / 2)
                 + Math.cos(Math.toRadians(lat1)) * Math.cos(Math.toRadians(lat2))
                 * Math.sin(lonDistance / 2) * Math.sin(lonDistance / 2);
        return 2 * R * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    private double calculateCoolingOptimization(double temp, double hum) {
        // Logic: For every degree above 25, cooling load increases
        return (temp > 25) ? (temp - 25) * 0.42 : 0.0;
    }

    private void generateExpeditionReport() {
        List<String> locations = Arrays.asList("Lonavala", "Alibaug", "Matheran", "SG Park", "Pawna");
        System.out.println("\nREGIONAL EXPEDITION LOGS:");
        locations.forEach(loc -> System.out.println(" > SCANNING CORE BIOME: " + loc));
    }
}

class Sector {
    String name;
    double lat, lon;
    Sector(String n, double la, double lo) { this.name = n; this.lat = la; this.lon = lo; }
}

class ThermalProfile {
    double temp, humidity;
    ThermalProfile(double t, double h) { this.temp = t; this.humidity = h; }
}
