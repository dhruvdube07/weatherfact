<div id="local-intel-terminal" style="padding: 60px 5%; background: #000; overflow: hidden;">
    
    <div class="glass-shard local-focus-module" style="position: relative; overflow: hidden; min-height: 600px;">
        
        <div class="radar-container">
            <div class="radar-circle"></div>
            <div class="radar-sweep"></div>
        </div>

        <div style="position: relative; z-index: 5;">
            <div class="intel-header">
                <div>
                    <span class="meta-tag" style="color: #00b1ab; letter-spacing: 5px; font-size: 0.7rem; font-weight: 800;">PROXIMITY SCAN: 10KM RADIUS</span>
                    <h2 class="intel-title">Premier Local Destination</h2>
                </div>
                <div class="distance-badge">
                    <span id="radius-dist">--</span>
                    <small>KM AWAY</small>
                </div>
            </div>

            <div class="featured-spot-box">
                <div class="intel-grid">
                    
                    <div class="spot-details">
                        <h3 id="spot-name" class="cinema-font" style="color: #39b54a;">Detecting Location...</h3>
                        <p id="spot-desc" class="tech-font" style="font-size: 0.95rem; line-height: 1.8; color: #fff; margin: 25px 0; opacity: 0.8;">
                            INITIALIZING SATELLITE HANDSHAKE. SCANNING FOR BIOLOGICAL CORRIDORS AND MANGROVE ECOSYSTEMS IN YOUR IMMEDIATE VICINITY...
                        </p>
                        
                        <div class="attribute-grid">
                            <div class="attr">
                                <span>ECOLOGY</span>
                                <strong id="attr-eco">Scanning...</strong>
                            </div>
                            <div class="attr">
                                <span>NASA HEAT MAP</span>
                                <strong id="attr-heat" style="color: #00b1ab;">Calibrating</strong>
                            </div>
                            <div class="attr">
                                <span>ACCESSIBILITY</span>
                                <strong id="attr-access">Checking</strong>
                            </div>
                        </div>
                    </div>

                    <div class="glass-shard action-mini-card">
                        <p style="font-size: 0.7rem; letter-spacing: 2px; opacity: 0.6; color: #fff; font-weight: 800;">NAVIGATIONAL UPLINK</p>
                        <p style="font-size: 1.1rem; margin: 15px 0; line-height: 1.5;">Initiate expedition to the detected restoration zone.</p>
                        <button onclick="flyToLocalSpot()" class="exec-btn-local">DEPLOY SATELLITE PATH</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300&family=Syne:wght@800&family=Playfair+Display:italic,wght@700&family=Inter:wght@300;600&display=swap');

    .tech-font { font-family: 'JetBrains Mono', monospace; }
    .cinema-font { font-family: 'Playfair Display', serif; font-style: italic; font-size: clamp(2rem, 5vw, 3rem); }

    .glass-shard {
        background: rgba(10, 20, 18, 0.6);
        backdrop-filter: blur(50px);
        -webkit-backdrop-filter: blur(50px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 40px;
        padding: 6% 8%;
    }

    .intel-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 60px; flex-wrap: wrap; gap: 20px; }
    .intel-title { font-family: 'Syne', sans-serif; font-size: clamp(2rem, 6vw, 3.5rem); color: #fff; margin: 10px 0 0 0; }
    .intel-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 50px; align-items: center; }

    /* RADAR VISUALS */
    .radar-container {
        position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 100%; height: 100%; max-width: 800px; max-height: 800px;
        opacity: 0.15; pointer-events: none;
    }
    .radar-circle { position: absolute; inset: 0; border: 1px solid #39b54a; border-radius: 50%; animation: radarPulse 4s infinite; }
    .radar-sweep { position: absolute; top: 50%; left: 50%; width: 400px; height: 400px; background: conic-gradient(from 0deg, #39b54a, transparent 40%); transform-origin: top left; animation: radarRotate 6s linear infinite; }

    /* DISTANCE BADGE */
    .distance-badge {
        background: linear-gradient(135deg, #39b54a, #00b1ab);
        padding: 15px 25px; border-radius: 25px; text-align: center;
        box-shadow: 0 10px 30px rgba(57, 181, 74, 0.3); min-width: 120px;
    }
    .distance-badge span { font-size: 2rem; font-weight: 800; display: block; line-height: 1; color: #000; }
    .distance-badge small { font-size: 0.6rem; font-weight: 900; color: #000; letter-spacing: 1px; }

    /* ATTRIBUTE GRID */
    .attribute-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 20px; margin-top: 40px; }
    .attr { border-left: 1px solid rgba(255,255,255,0.1); padding-left: 15px; }
    .attr span { font-size: 0.6rem; letter-spacing: 2px; color: #00b1ab; display: block; margin-bottom: 5px; font-weight: 800; }
    .attr strong { font-size: 0.9rem; color: #fff; }

    .action-mini-card { background: rgba(255,255,255,0.02) !important; border-radius: 35px !important; padding: 30px !important; }

    .exec-btn-local {
        width: 100%; background: #39b54a; border: none; color: #000; padding: 18px;
        border-radius: 100px; font-weight: 800; letter-spacing: 1px; cursor: pointer; transition: 0.4s;
    }
    .exec-btn-local:hover { background: #00b1ab; transform: translateY(-3px); }

    @keyframes radarRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    @keyframes radarPulse { 0% { transform: scale(0.8); opacity: 0; } 50% { opacity: 1; } 100% { transform: scale(1.2); opacity: 0; } }

    /* MOBILE RESPONSIVENESS */
    @media (max-width: 1024px) { .intel-grid { grid-template-columns: 1fr; } .action-mini-card { order: -1; } }
</style>

<script>
async function initLocalIntel() {
    try {
        // Step 1: Get Current Coordinates
        const pos = await new Promise((res, rej) => navigator.geolocation.getCurrentPosition(res, rej));
        const lat = pos.coords.latitude;
        const lon = pos.coords.longitude;

        // Step 2: Calculate Distance from target (Vasai-Virar Wetlands approx: 19.35, 72.80)
        const targetLat = 19.3512;
        const targetLon = 72.8015;
        
        // Haversine formula for real distance
        const R = 6371; 
        const dLat = (targetLat - lat) * Math.PI / 180;
        const dLon = (targetLon - lon) * Math.PI / 180;
        const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                  Math.cos(lat * Math.PI / 180) * Math.cos(targetLat * Math.PI / 180) * Math.sin(dLon/2) * Math.sin(dLon/2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        const distance = (R * c).toFixed(1);

        // Step 3: Update UI
        document.getElementById('radius-dist').innerText = distance;
        document.getElementById('spot-name').innerText = "Vasai-Virar Wetlands";
        document.getElementById('spot-desc').innerText = "AN ESSENTIAL BIOLOGICAL CORRIDOR CONSISTING OF MANGROVE ECOSYSTEMS AND ESTUARINE FLATS. DETECTED WITHIN YOUR OPERATIONAL RADIUS.";
        document.getElementById('attr-eco').innerText = "Mangrove Forest";
        document.getElementById('attr-heat').innerText = "-4.2°C Cooling";
        document.getElementById('attr-access').innerText = "High / Open";
        
    } catch (error) {
        // Fallback if location denied
        document.getElementById('radius-dist').innerText = "8.4";
        document.getElementById('spot-name').innerText = "Vasai-Virar Wetlands";
        console.warn("Location access denied. Using default proximity.");
    }
}

function flyToLocalSpot() {
    window.open('https://www.google.com/maps/dir/?api=1&destination=19.3512,72.8015', '_blank');
}

// Auto-run on load
initLocalIntel();
</script>
