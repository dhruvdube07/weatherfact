        background: #39b54a;
        border: none;
        color: #000;
        padding: 20px;
        border-radius: 100px;
        font-weight: 700;
        letter-spacing: 1px;
        cursor: pointer;
        transition: 0.4s;
    }
    .exec-btn-local:hover { background: #00b1ab; transform: scale(1.02); }

    @keyframes radarRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    @keyframes radarPulse { 0% { transform: scale(0.8); opacity: 0; } 50% { opacity: 1; } 100% { transform: scale(1.2); opacity: 0; } }
</style>

