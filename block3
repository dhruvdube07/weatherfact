        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 80px;
        padding: 60px;
    }

    /* RADAR VISUALS */
    .radar-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 800px;
        height: 800px;
        opacity: 0.15;
        pointer-events: none;
    }
    .radar-circle {
        position: absolute;
        inset: 0;
        border: 1px solid #39b54a;
        border-radius: 50%;
        animation: radarPulse 4s infinite;
    }
    .radar-sweep {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 400px;
        height: 400px;
        background: conic-gradient(from 0deg, #39b54a, transparent 40%);
        transform-origin: top left;
        animation: radarRotate 6s linear infinite;
    }

    /* DISTANCE BADGE */
    .distance-badge {
        background: linear-gradient(135deg, #39b54a, #00b1ab);
        padding: 20px 30px;
        border-radius: 40px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(57, 181, 74, 0.3);
    }
    .distance-badge span { font-size: 2.5rem; font-weight: 800; display: block; line-height: 1; color: #000; }
    .distance-badge small { font-size: 0.7rem; font-weight: 900; color: #000; letter-spacing: 1px; }

    /* ATTRIBUTE GRID */
    .attribute-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
    .attr { border-left: 1px solid rgba(255,255,255,0.1); padding-left: 20px; }
    .attr span { font-size: 0.6rem; letter-spacing: 2px; color: #00b1ab; display: block; margin-bottom: 5px; }
